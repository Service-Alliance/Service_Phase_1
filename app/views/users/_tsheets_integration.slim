.panel.panel-primary
  .panel-heading
    | TSheets Linking
  .panel-body
    #tsheets_integration_container data-user-id="#{user.id}"
      - if local_assigns.fetch(:error, nil).present?
        .alert.alert-danger
          i.fa.fa-times
          = error
      - if user.tsheets_id.present?
        .alert.alert-success
          i.fa.fa-check-circle
          | TSheets user linked
        .item
          | TSheets user name:
          |  #{user.tsheets_full_name}
        button#unlink_tsheets_user.btn.btn-primary type="button"  Unlink user
        i.tsheets-user-status
      - else
        .item
          | Link to TSheets user:
          |  #{text_field_tag :tsheets_user, '', class: 'form-control with-status', data: {user_id: user.id}}
          i.tsheets-user-status
